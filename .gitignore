# =====================================================================
# DSH 会话管理工具 —— Git 忽略规则
# 忽略所有"本机构建产物 / 虚拟环境 / IDE 配置"，只保留源码与素材
# =====================================================================

# ---- Python 虚拟环境与缓存 ----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/

# ---- PyInstaller 构建产物 ----
build/
dist/
build_assets/
*.spec

# ---- IDE / 编辑器 ----
.idea/
.vscode/
*.swp
*.swo

# ---- 操作系统杂项 ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- 本地临时文件 ----
*.tmp
*.log
